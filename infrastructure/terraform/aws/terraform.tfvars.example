aws_region         = "ap-south-1"
name               = "incidentpilot"
kubernetes_version = "1.34"

# Replace with the operator/VPN public CIDR. Unrestricted access is rejected.
public_access_cidrs = ["203.0.113.10/32"]

# One NAT gateway is cheaper for a portfolio environment; set false for AZ redundancy.
single_nat_gateway = true

tags = {
  Environment = "portfolio"
  Owner       = "replace-me"
}
