# Copy this file to .env, then provide your own API key.
INCIDENTPILOT_LLM_PROVIDER=groq
INCIDENTPILOT_LLM_MODEL=openai/gpt-oss-20b
INCIDENTPILOT_LLM_API_KEY=replace-with-your-groq-api-key
# Optional for Groq GPT-OSS: low (default), medium, or high.
# INCIDENTPILOT_GROQ_REASONING_EFFORT=low

# Local kind port-forward settings.
INCIDENTPILOT_DATABASE_URL=postgres://incidentpilot:incidentpilot-local-dev-only@127.0.0.1:15432/incidentpilot?sslmode=disable
INCIDENTPILOT_MCP_ENDPOINT=http://127.0.0.1:18081/mcp
INCIDENTPILOT_MCP_TOKEN=incidentpilot-mcp-local-dev-token-v1
INCIDENTPILOT_REMEDIATION_ENDPOINT=http://127.0.0.1:18080/api/v1/remediations
INCIDENTPILOT_REMEDIATION_TOKEN=incidentpilot-remediation-local-dev-token-v1
INCIDENTPILOT_ENVIRONMENT=development
INCIDENTPILOT_REPOSITORY=YASHMAHAKAL/incident-pilot
INCIDENTPILOT_REMEDIATION_PATH=deploy/kind/30-demo.yaml

# Optional Phase 11 API-server configuration. Use a fine-grained token or
# GitHub App installation token restricted to this repository's contents and
# pull requests. This is separate from the Phase 8 read-only MCP credential.
# INCIDENTPILOT_GITHUB_WRITE_API_URL=https://api.github.com
# INCIDENTPILOT_GITHUB_WRITE_TOKEN=replace-with-short-lived-github-write-token
# INCIDENTPILOT_GITHUB_BASE_BRANCH=main

# Optional Phase 8 MCP-server configuration. These values belong on the MCP
# process (or in the optional incidentpilot-change-sources Kubernetes Secret),
# not in LLM prompts. Use an Argo CD read-only token and GitHub contents:read.
# INCIDENTPILOT_ARGOCD_URL=http://argocd-server.argocd.svc.cluster.local
# INCIDENTPILOT_ARGOCD_TOKEN=replace-with-read-only-argocd-token
# INCIDENTPILOT_ARGOCD_APPLICATION=incidentpilot-demo
# INCIDENTPILOT_ARGOCD_PROJECT=default
# INCIDENTPILOT_GITHUB_API_URL=https://api.github.com
# INCIDENTPILOT_GITHUB_REPOSITORY=owner/incident-pilot
# INCIDENTPILOT_GITHUB_TOKEN=replace-with-read-only-github-token
